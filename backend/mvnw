#!/bin/sh
# Maven Wrapper script
# This script downloads Maven if not present and runs it

set -e

MAVEN_VERSION="3.9.9"
mkdir -p "$(dirname "$0")/.mvn/wrapper"
WRAPPER_DIR="$(cd "$(dirname "$0")/.mvn/wrapper" && pwd)"
MAVEN_HOME="${WRAPPER_DIR}/maven-${MAVEN_VERSION}"
MAVEN_CMD="${MAVEN_HOME}/bin/mvn"

if [ ! -f "${MAVEN_CMD}" ]; then
    echo "Downloading Maven ${MAVEN_VERSION}..."
    DIST_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.tar.gz"
    mkdir -p "${MAVEN_HOME}"
    if command -v curl > /dev/null 2>&1; then
        curl -fsSL "${DIST_URL}" | tar xz --strip-components=1 -C "${MAVEN_HOME}"
    elif command -v wget > /dev/null 2>&1; then
        wget -qO- "${DIST_URL}" | tar xz --strip-components=1 -C "${MAVEN_HOME}"
    else
        echo "Error: curl or wget required to download Maven" >&2
        exit 1
    fi
fi

exec "${MAVEN_CMD}" "$@"
